{
  "name": "coffee-manager-101",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-menu-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-menu-images.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
